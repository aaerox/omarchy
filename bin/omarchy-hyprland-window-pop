#!/bin/bash

# Toggle to pop-out a tile to stay fixed on a display basis, with Plex-specific sizing.

active=$(hyprctl activewindow -j)
pinned=$(echo "$active" | jq .pinned)
addr=$(echo "$active" | jq -r ".address")
cls=$(echo "$active" | jq -r ".class")
[ -z "$addr" ] && { echo "No active window"; exit 0; }

# Hyprland's Lua config mode evaluates the dispatch payload as Lua, so these are
# hl.dsp.* calls rather than the legacy "dispatch togglefloating address:0x..."
# strings (which fail silently).
win="address:$addr"

# hyprctl --batch wants the commands as ONE ';'-separated argument with no
# stray leading whitespace, so join them here rather than passing them
# individually.
batch() {
  local IFS=';'
  hyprctl -q --batch "$*"
}

if [ "$pinned" = "true" ]; then
  batch \
    "dispatch hl.dsp.window.pin({ window = '$win' })" \
    "dispatch hl.dsp.window.float({ action = 'toggle', window = '$win' })" \
    "dispatch hl.dsp.window.tag({ tag = '-pop', window = '$win' })"
else
  batch \
    "dispatch hl.dsp.window.float({ action = 'toggle', window = '$win' })" \
    "dispatch hl.dsp.window.center({ window = '$win' })" \
    "dispatch hl.dsp.window.pin({ window = '$win' })" \
    "dispatch hl.dsp.window.alter_zorder({ mode = 'top', window = '$win' })" \
    "dispatch hl.dsp.window.tag({ tag = '+pop', window = '$win' })"

  # Plex-specific size override after tagging
  if [[ "$cls" == "tv.plex.plex-bin" ]]; then
    hyprctl -q dispatch "hl.dsp.window.resize({ x = 960, y = 540, window = '$win' })"
  fi
fi
