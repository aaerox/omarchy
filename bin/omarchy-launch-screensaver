#!/bin/bash

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f "kitty --class=Screensaver" && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/omarchy/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')

screensaver_cmd="kitty --class=Screensaver \
-o background=#000000 \
-o cursor=#000000 \
-o font_size=18.0 \
-o background_opacity=1.0 \
omarchy-cmd-screensaver"

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch "hl.dsp.focus({ monitor = '$m' })"

  # Lua long-bracket string: the command contains '#' and quotes we don't want
  # Lua to interpret.
  hyprctl dispatch "hl.dsp.exec_cmd([[$screensaver_cmd]])"
done

hyprctl dispatch "hl.dsp.focus({ monitor = '$focused' })"
