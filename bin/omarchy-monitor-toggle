#!/usr/bin/env bash
# Toggle monitor on/off using hyprctl

if [ -z "$1" ]; then
    echo "Usage: omarchy-monitor-toggle <monitor-name>"
    echo "Example: omarchy-monitor-toggle HDMI-A-1"
    exit 1
fi

MONITOR="$1"
AUDIO_MONITOR="DP-3"  # Anthem MRX 540 AV receiver (audio-only via DP->HDMI)

# Check DPMS and enabled state via JSON
DPMS_STATUS=$(hyprctl monitors all -j | jq -r --arg m "$MONITOR" '.[] | select(.name == $m) | .dpmsStatus')
DISABLED=$(hyprctl monitors all -j | jq -r --arg m "$MONITOR" '.[] | select(.name == $m) | .disabled')

if [ "$DISABLED" = "true" ]; then
    # Monitor is fully disabled, enable it
    case "$MONITOR" in
        "DP-2")
            hyprctl keyword monitor "$MONITOR,2560x1440@144,0x0,1"
            ;;
        "HDMI-A-1")
            hyprctl keyword monitor "$MONITOR,3840x2160@60,-1920x0,2"
            ;;
        *)
            hyprctl keyword monitor "$MONITOR,preferred,auto,auto"
            ;;
    esac
elif [ "$DPMS_STATUS" = "false" ]; then
    # Monitor is DPMS-off, wake it
    hyprctl dispatch "hl.dsp.dpms({ state = 'on', monitor = '$MONITOR' })"
else
    # Monitor is on, turn it off
    case "$MONITOR" in
        "DP-2")
            # Use DPMS to avoid modeset that disrupts audio monitor
            hyprctl dispatch "hl.dsp.dpms({ state = 'off', monitor = '$MONITOR' })"
            ;;
        *)
            # Fully disable (removes from layout)
            hyprctl keyword monitor "$MONITOR,disable"
            ;;
    esac
fi
