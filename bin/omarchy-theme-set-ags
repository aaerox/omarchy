#!/bin/bash

# Generates AGS theme from omarchy walker.css colors

THEME_DIR="$HOME/.config/omarchy/current/theme"
WALKER="$THEME_DIR/walker.css"

if [[ ! -f "$WALKER" ]]; then
    echo "No walker.css found in current theme"
    exit 1
fi

# Get color from walker.css (@define-color name #hex;)
get_color() {
    grep "@define-color $1" "$WALKER" | head -1 | sed -E 's/.*#([^;]+);.*/#\1/'
}

BG=$(get_color "background")
FG=$(get_color "foreground")
ACCENT=$(get_color "selected-text")

# Update _wal.scss with new colors
WAL_SCSS="$HOME/.local/share/omarchy/config/ags/styles/_wal.scss"
cat > "$WAL_SCSS" << SCSS
// Theme colors - generated by omarchy-theme-set-ags
\$background: $BG;
\$foreground: $FG;
\$accent: $ACCENT;
SCSS

# Compile SCSS to CSS
AGS_DIR="$HOME/.local/share/omarchy/config/ags"
AGS_CONFIG="$HOME/.config/ags"
if [[ -f "$AGS_DIR/styles/main.scss" ]]; then
    cd "$AGS_DIR" && npx sass styles/main.scss "$AGS_CONFIG/style.css" 2>/dev/null
fi

# Restart AGS to apply new styles
if pgrep -f "gjs.*ags" >/dev/null; then
    pkill -f "gjs.*ags"
    sleep 0.3
    setsid uwsm-app -- ags run -d ~/.local/share/omarchy/config/ags --gtk 4 >/dev/null 2>&1 &
fi

echo "AGS theme colors updated from $(basename "$(readlink "$THEME_DIR")")"